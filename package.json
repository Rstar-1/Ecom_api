{
  "name": "ecom-api",
  "version": "2.0.0",
  "description": "E-commerce REST API (TypeScript monolith: Express + MongoDB)",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsc-watch --noClear --onSuccess \"npm start\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2"
  }
}
