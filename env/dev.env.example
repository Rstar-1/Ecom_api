NODE_ENV=development
PORT=5000

# Database (MongoDB connection string)
DATABASE=mongodb://localhost:27017/ecommerce

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000

# Razorpay (online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Twilio (campaign SMS & WhatsApp). Leave empty to simulate sends.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Public URL Twilio posts delivery updates to; also used to verify X-Twilio-Signature
TWILIO_STATUS_CALLBACK_URL=http://localhost:5000/api/campaigns/webhook/twilio

# SMTP (campaign emails). For Gmail use a 16-character App Password (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=offers@yourbrand.in
SENDER_NAME=Company
