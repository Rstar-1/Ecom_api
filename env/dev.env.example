NODE_ENV=development
PORT=5000

# Database (MongoDB Atlas)
DATABASE=mongodb://localhost:27017/ecom

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000

# Twilio Integration (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_STATUS_CALLBACK_URL=http://localhost:5000/api/campaigns/webhook/twilio

# Nodemailer Email Configuration (Gmail / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
SENDER_NAME=Company

# GitHub Direct Image Upload Storage
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_OWNER=Rstar-1
GITHUB_REPO=generic_images
GITHUB_BRANCH=main
GITHUB_FOLDER=ashmita

