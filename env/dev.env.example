NODE_ENV=development
LOG_LEVEL=debug

# Gateway
GATEWAY_PORT=5000
PORT=5000

# Microservice Ports
AUTH_PORT=8080
USER_PORT=8082
PRODUCT_PORT=8083
CART_PORT=5004
ORDER_PORT=5005
PAYMENT_PORT=5006
ROLE_PORT=5007

# Service URLs
AUTH_SERVICE_URL=http://localhost:8080
USER_SERVICE_URL=http://localhost:8082
PRODUCT_SERVICE_URL=http://localhost:8083
CART_SERVICE_URL=http://localhost:5004
ORDER_SERVICE_URL=http://localhost:5005
PAYMENT_SERVICE_URL=http://localhost:5006
ROLE_SERVICE_URL=http://localhost:5007

# Database (MongoDB connection string)
DATABASE=mongodb://localhost:27017/ecomproduct

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

