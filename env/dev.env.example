NODE_ENV=development
LOG_LEVEL=debug

# Gateway
GATEWAY_PORT=5000
PORT=5000

# Microservice Ports
ROLE_PORT=8081
AUTH_PORT=8082
USER_PORT=8083
PRODUCT_PORT=8084
BLOG_PORT=8085
LEAD_PORT=8086
CMS_PORT=8087
SEO_PORT=8088

# Service URLs
ROLE_SERVICE_URL=http://localhost:8081
AUTH_SERVICE_URL=http://localhost:8082
USER_SERVICE_URL=http://localhost:8083
PRODUCT_SERVICE_URL=http://localhost:8084
BLOG_SERVICE_URL=http://localhost:8085
LEAD_SERVICE_URL=http://localhost:8086
CMS_SERVICE_URL=http://localhost:8087
SEO_SERVICE_URL=http://localhost:8088

# Database (MongoDB connection string)
DATABASE=mongodb://localhost:27017/ecommerce

# JWT
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000
